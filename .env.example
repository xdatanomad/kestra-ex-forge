# Copy to .env (gitignored) and fill in. Local demo values only.
POSTGRES_DB="kestra"
POSTGRES_USER="kestra"
POSTGRES_PASSWORD="change-me"
KESTRA_SECRET_JDBC_SECRET="change-me-to-a-long-random-string"
KESTRA_ENCRYPTION_SECRET_KEY="change-me-to-a-long-random-string"
KESTRA_BASIC_AUTH_USERNAME="admin@kestra.io"
KESTRA_BASIC_AUTH_PASSWORD="change-me"
# Optional: enables the AI agent in the service desk (falls back to rules when empty/failing).
KESTRA_GEMINI_API_KEY=""
# Enterprise Edition license (Apps, Assets and Cases need EE 2.0).
KESTRA_EE_LICENSE_ID=""
KESTRA_EE_LICENSE_FINGERPRINT=""
KESTRA_EE_LICENSE_KEY=""

KESTRA_IMAGE="registry.kestra.io/docker/kestra-ee:v2.0.7"
POSTGRES_IMAGE="postgres:16"
